rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Public profile: display name, share id and the two visibility switches.
    match /users/{uid} {
      allow get: if true;
      allow write: if isOwner(uid);

      // Discogs token and anything else that must stay with its owner.
      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /collection/{item} {
        allow read: if isOwner(uid) || profile(uid).collectionPublic == true;
        allow write: if isOwner(uid);
      }

      match /wishlist/{item} {
        allow read: if isOwner(uid) || profile(uid).wishlistPublic == true;
        allow write: if isOwner(uid);
      }
    }

    // Short link → owner. Written once, never repointed.
    match /shares/{shareId} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
