rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Wishlists collection (Top-level)
    match /wishlists/{wishlistId} {
      // Create: Allow if user provides their own UID or ANY sessionId
      allow create: if (isAuthenticated() && request.resource.data.ownerId == request.auth.uid) ||
                       (!isAuthenticated() && request.resource.data.sessionId != null);
      
      // Read: 
      // 1. Owner (Authenticated)
      // 2. Is Public (Anyone)
      // 3. Has Session ID (Anonymous owner)
      // Note: In production, sessionId should be treated as a secret.
      allow read: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) ||
                     (resource.data.isPublic == true) ||
                     (resource.data.sessionId != null);
      
      // Update/Delete: Owner or Session holder
      allow update, delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) ||
                               (resource.data.sessionId != null);
      
      // Items subcollection
      match /items/{itemId} {
        // Read: owner, public wishlist, or session wishlist
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.ownerId == request.auth.uid) ||
                       (get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.isPublic == true) ||
                       (!isAuthenticated() && get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.sessionId != null);

        // Write: only the authenticated owner, or unauthenticated session wishlist
        allow write: if (isAuthenticated() && get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.ownerId == request.auth.uid) ||
                        (!isAuthenticated() && get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.sessionId != null);
      }
    }
  }
}
